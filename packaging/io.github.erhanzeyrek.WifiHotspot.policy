<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>RelayForge</vendor>
  <vendor_url>https://github.com/3togo/relayforge</vendor_url>

  <action id="io.github.erhanzeyrek.WifiHotspot.control">
    <description>Start or stop the configured Wi-Fi Hotspot</description>
    <message>Control Wi-Fi Hotspot</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.github.erhanzeyrek.WifiHotspot.manage">
    <description>Manage Wi-Fi Hotspot</description>
    <message>Authentication is required to view credentials or configure Wi-Fi Hotspot</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
