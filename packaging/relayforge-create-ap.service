[Unit]
Description=RelayForge Rust-supervised create_ap sharing
After=NetworkManager.service dbus.service
Conflicts=wifi-hotspot-daemon.service relayforge.service relayforge-native.service

[Service]
Type=dbus
BusName=io.github.erhanzeyrek.WifiHotspot
ExecStart=/usr/lib/relayforge/relayforge-service --native-create-ap --legacy-root /usr/lib/relayforge
User=root
RuntimeDirectory=relayforge
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStopSec=100
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
