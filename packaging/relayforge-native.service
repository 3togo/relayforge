[Unit]
StartLimitIntervalSec=300
StartLimitBurst=10
Description=RelayForge native NetworkManager Wi-Fi sharing
Requires=NetworkManager.service
After=NetworkManager.service dbus.service
Conflicts=wifi-hotspot-daemon.service relayforge.service relayforge-create-ap.service

[Service]
Type=dbus
BusName=io.github.erhanzeyrek.WifiHotspot
ExecStart=/usr/lib/relayforge/relayforge-service --native-networkmanager
# The pinned daemon recovers owned resources after every stop, including a
# crash (nm_backend.py --recover-all). Recovery is journal-scoped and idempotent.
ExecStopPost=/usr/lib/relayforge/relayforge-service --native-networkmanager --recover-all
User=root
RuntimeDirectory=relayforge
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStopSec=75
Restart=on-failure
RestartSec=5
# 17 is EXIT_MISSING_CONFIG in relayforge-service: never retry it.
RestartPreventExitStatus=17
NoNewPrivileges=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
