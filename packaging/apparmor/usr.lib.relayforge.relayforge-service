# AppArmor profile for the RelayForge native service.
#
# Shipped with flags=(complain) and also loaded in complain mode by the package
# postinst. A MAC profile must be validated against live hardware before it can
# be enforced; complain mode records violations without blocking.
#
# The service re-executes itself to spawn gated child daemons, then exec's the
# AP daemons hostapd and dnsmasq. Those now transition into dedicated child
# profiles (still complain) so enforcement can be enabled once the child access
# patterns are confirmed against live hardware.
#include <tunables/global>

profile /usr/lib/relayforge/relayforge-service flags=(complain) {
  #include <abstractions/base>

  capability net_admin,
  capability net_raw,
  capability net_bind_service,
  capability sys_ptrace,

  network inet,
  network inet6,
  network netlink,

  /usr/lib/relayforge/relayforge-service mr,
  /usr/lib/relayforge/** r,
  /etc/relayforge/** rwk,
  /run/relayforge/** rwk,
  /run/dbus/system_bus_socket rw,
  /run/systemd/notify w,
  /proc/** r,
  /sys/** r,

  # The service re-executes itself to spawn gated child daemons, then exec's the
  # third-party AP daemons. Keep the relayforge child transition; confine the
  # AP daemons through dedicated child profiles.
  pix /usr/lib/relayforge/relayforge-service,
  /usr/sbin/hostapd Px -> hostapd,
  /usr/sbin/dnsmasq Px -> dnsmasq,

  profile hostapd flags=(complain) {
    #include <abstractions/base>

    capability net_admin,
    capability net_raw,
    capability net_bind_service,
    capability setuid,
    capability setgid,

    network inet,
    network inet6,

    /usr/sbin/hostapd mr,
    /usr/lib/relayforge/** r,
    /etc/relayforge/** rwk,
    /run/relayforge/** rwk,
    /run/systemd/notify w,
    /proc/** r,
    /sys/** r,
  }

  profile dnsmasq flags=(complain) {
    #include <abstractions/base>

    capability net_bind_service,
    capability net_admin,
    capability setuid,
    capability setgid,

    network inet,
    network inet6,

    /usr/sbin/dnsmasq mr,
    /usr/lib/relayforge/** r,
    /etc/relayforge/** rwk,
    /run/relayforge/** rwk,
    /proc/** r,
    /sys/** r,
  }
}
