diff --git a/src/libnm-core-intern/nm-wifi-relay.h b/src/libnm-core-intern/nm-wifi-relay.h
new file mode 100644
index 0000000..57d646d
--- /dev/null
+++ b/src/libnm-core-intern/nm-wifi-relay.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef NM_WIFI_RELAY_H
+#define NM_WIFI_RELAY_H
+
+#include "libnm-core-intern/nm-core-internal.h"
+
+/* Downstream development contract, carried in ordinary user metadata. */
+#define NM_WIFI_RELAY_PARENT_KEY "org.freedesktop.NetworkManager.wifi-relay.parent"
+#define NM_WIFI_RELAY_CAPABILITY 0x7001
+
+static inline const char *
+nm_wifi_relay_get_parent(NMConnection *connection)
+{
+    NMSettingUser *user =
+        NM_SETTING_USER(nm_connection_get_setting(connection, NM_TYPE_SETTING_USER));
+
+    return user ? nm_setting_user_get_data(user, NM_WIFI_RELAY_PARENT_KEY) : NULL;
+}
+
+static inline gboolean
+nm_wifi_relay_verify(NMConnection *connection, GError **error)
+{
+    const char                *parent   = nm_wifi_relay_get_parent(connection);
+    const char                *iface    = nm_connection_get_interface_name(connection);
+    NMSettingWireless         *wifi     = nm_connection_get_setting_wireless(connection);
+    NMSettingWirelessSecurity *security = nm_connection_get_setting_wireless_security(connection);
+    NMSettingIPConfig         *ip4      = nm_connection_get_setting_ip4_config(connection);
+    NMSettingConnection       *s_con    = nm_connection_get_setting_connection(connection);
+
+    if (!parent)
+        return TRUE;
+    if (!nm_utils_ifname_valid_kernel(parent, NULL) || !iface
+        || !nm_utils_ifname_valid_kernel(iface, NULL) || nm_streq(parent, iface) || !wifi
+        || !nm_streq0(nm_setting_wireless_get_mode(wifi), NM_SETTING_WIRELESS_MODE_AP)
+        || !nm_setting_wireless_get_band(wifi)
+        || !NM_IN_STRSET(nm_setting_wireless_get_band(wifi), "bg", "a")
+        || !nm_setting_wireless_get_channel(wifi)
+        || !nm_streq0(nm_setting_wireless_get_cloned_mac_address(wifi), "preserve") || !ip4
+        || !nm_streq0(nm_setting_ip_config_get_method(ip4), NM_SETTING_IP4_CONFIG_METHOD_SHARED)
+        || !security || !nm_streq0(nm_setting_wireless_security_get_key_mgmt(security), "wpa-psk")
+        || nm_setting_wireless_security_get_num_protos(security) != 1
+        || !nm_streq0(nm_setting_wireless_security_get_proto(security, 0), "rsn") || !s_con
+        || nm_setting_connection_get_autoconnect(s_con)) {
+        g_set_error_literal(
+            error,
+            NM_CONNECTION_ERROR,
+            NM_CONNECTION_ERROR_INVALID_PROPERTY,
+            "Wi-Fi Relay requires distinct parent/child interfaces, AP mode, "
+            "a fixed band/channel, preserved AP MAC, WPA2, shared IPv4, and autoconnect disabled");
+        return FALSE;
+    }
+    return TRUE;
+}
+
+#endif
