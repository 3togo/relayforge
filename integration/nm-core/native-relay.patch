diff --git a/src/core/devices/wifi/nm-wifi-relay-utils.h b/src/core/devices/wifi/nm-wifi-relay-utils.h
new file mode 100644
index 0000000..666b870
--- /dev/null
+++ b/src/core/devices/wifi/nm-wifi-relay-utils.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef NM_WIFI_RELAY_UTILS_H
+#define NM_WIFI_RELAY_UTILS_H
+
+#include "libnm-platform/nm-platform.h"
+
+static inline gboolean
+nm_wifi_relay_link_owned(const NMPlatformLink *link,
+                         int                   ifindex,
+                         const char           *name,
+                         const guint8         *mac)
+{
+    return link && link->ifindex == ifindex && link->type == NM_LINK_TYPE_WIFI
+           && nm_streq(link->name, name) && link->l_address.len == 6
+           && memcmp(link->l_address.data, mac, 6) == 0;
+}
+
+#endif
