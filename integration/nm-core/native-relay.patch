@@ -10378,6 +10378,44 @@ wifi_get_station(NMPlatform  *platform,
     return nm_wifi_utils_get_station(wifi_data, out_bssid, out_quality, out_rate);
 }
 
+static int
+wifi_relay_add(NMPlatform            *platform,
+               int                    parent,
+               const char            *name,
+               guint32                frequency,
+               const guint8          *mac,
+               const NMPlatformLink **out_link)
+{
+    int r, ifindex;
+    WIFI_GET_WIFI_DATA_NETNS(wifi_data, platform, parent, -EOPNOTSUPP);
+
+    r = nm_wifi_utils_relay_add(wifi_data, name, frequency, mac);
+    if (r < 0)
+        return r;
+    ifindex = r;
+    if (ifindex <= 0)
+        return -ENODEV;
+    nm_platform_link_refresh(platform, ifindex);
+    *out_link = nm_platform_link_get(platform, ifindex);
+    if (!*out_link || (*out_link)->type != NM_LINK_TYPE_WIFI || !nm_streq((*out_link)->name, name)
+        || (*out_link)->l_address.len != 6 || memcmp((*out_link)->l_address.data, mac, 6) != 0) {
+        *out_link = NULL;
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static int
+wifi_relay_delete(NMPlatform *platform, int ifindex)
+{
+    int r;
+    WIFI_GET_WIFI_DATA_NETNS(wifi_data, platform, ifindex, -EOPNOTSUPP);
+    r = nm_wifi_utils_relay_delete(wifi_data);
+    if (r >= 0)
+        nm_platform_process_events(platform);
+    return r;
+}
