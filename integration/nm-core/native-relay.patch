+/* Native Wi-Fi Relay additions: LGPL-2.1-or-later. */
+static gboolean
+relay_unrealize(NMDevice *device, GError **error)
+{
+    NMDeviceWifiPrivate  *priv     = NM_DEVICE_WIFI_GET_PRIVATE(device);
+    NMPlatform           *platform = nm_device_get_platform(device);
+    const NMPlatformLink *link;
+
+    if (!priv->relay_virtual || priv->relay_ifindex <= 0)
+        return TRUE;
+    link = nm_platform_link_get(platform, priv->relay_ifindex);
+    if (!link)
+        return TRUE;
+    if (!nm_wifi_relay_link_owned(link,
+                                  priv->relay_ifindex,
+                                  nm_device_get_iface(device),
+                                  priv->relay_mac)) {
+        g_set_error_literal(error,
+                            NM_DEVICE_ERROR,
+                            NM_DEVICE_ERROR_FAILED,
+                            "Wi-Fi Relay interface identity changed; refusing to remove it");
+        return FALSE;
+    }
+    if (nm_platform_wifi_relay_delete(platform, priv->relay_ifindex) < 0) {
+        g_set_error_literal(error,
+                            NM_DEVICE_ERROR,
+                            NM_DEVICE_ERROR_FAILED,
+                            "Failed to remove the owned Wi-Fi Relay interface");
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void
+relay_unrealize_notify(NMDevice *device)
+{
+    NMDeviceWifiPrivate *priv = NM_DEVICE_WIFI_GET_PRIVATE(device);
+
+    nm_clear_g_source(&priv->relay_watch);
+    g_clear_object(&priv->relay_parent_connection);
+    priv->relay_ifindex   = 0;
+    priv->relay_frequency = 0;
+    NM_DEVICE_CLASS(nm_device_wifi_parent_class)->unrealize_notify(device);
+}
+
+static gboolean
+relay_parent_watch(gpointer user_data)
+{
+    NMDeviceWifi             *self   = NM_DEVICE_WIFI(user_data);
+    gs_unref_object NMDevice *device = g_object_ref(NM_DEVICE(self));
+    NMDeviceWifiPrivate      *priv   = NM_DEVICE_WIFI_GET_PRIVATE(self);
+    NMDevice                 *parent = nm_device_parent_get_device(device);
+    NMDeviceState             state  = nm_device_get_state(device);
+    gboolean                  valid;
+
+    valid = parent && nm_device_get_state(parent) == NM_DEVICE_STATE_ACTIVATED
+            && nm_device_get_applied_connection(parent) == priv->relay_parent_connection
+            && nm_platform_wifi_get_frequency(nm_device_get_platform(device),
+                                              nm_device_get_ifindex(parent))
+                   == priv->relay_frequency;
+    if (!valid) {
+        priv->relay_watch = 0;
+        if (state >= NM_DEVICE_STATE_PREPARE && state <= NM_DEVICE_STATE_ACTIVATED)
+            nm_device_state_changed(device,
+                                    NM_DEVICE_STATE_FAILED,
+                                    NM_DEVICE_STATE_REASON_DEPENDENCY_FAILED);
+        else if (nm_device_is_real(device)) {
+            gs_free_error GError *error = NULL;
+            if (!nm_device_unrealize(device, TRUE, &error))
+                _LOGW(LOGD_WIFI, "Wi-Fi Relay cleanup failed: %s", error->message);
+        }
+        return G_SOURCE_REMOVE;
+    }
+    return G_SOURCE_CONTINUE;
+}
+
+static gboolean
+relay_create_and_realize(NMDevice              *device,
+                         NMConnection          *connection,
+                         NMDevice              *parent,
+                         const NMPlatformLink **out_link,
+                         GError               **error)
+{
+    NMDeviceWifiPrivate *priv     = NM_DEVICE_WIFI_GET_PRIVATE(device);
+    NMPlatform          *platform = nm_device_get_platform(device);
+    NMSettingWireless   *wifi     = nm_connection_get_setting_wireless(connection);
+    guint32              frequency;
+    int                  r;
+
+    if (!priv->relay_virtual || !nm_wifi_relay_verify(connection, error)) {
+        if (!error || !*error)
+            g_set_error_literal(error,
+                                NM_DEVICE_ERROR,
+                                NM_DEVICE_ERROR_FAILED,
+                                "Not a Wi-Fi Relay profile");
+        return FALSE;
+    }
+    if (!parent || !NM_IS_DEVICE_WIFI(parent) || NM_DEVICE_WIFI_GET_PRIVATE(parent)->relay_virtual
+        || !nm_streq(nm_device_get_iface(parent), nm_wifi_relay_get_parent(connection))
+        || nm_device_get_state(parent) != NM_DEVICE_STATE_ACTIVATED
+        || nm_platform_wifi_get_mode(platform, nm_device_get_ifindex(parent))
+               != _NM_802_11_MODE_INFRA) {
+        g_set_error_literal(error,
+                            NM_DEVICE_ERROR,
+                            NM_DEVICE_ERROR_MISSING_DEPENDENCIES,
+                            "Wi-Fi Relay requires an active wpa_supplicant station parent");
+        return FALSE;
+    }
+    frequency = nm_utils_wifi_channel_to_freq(nm_setting_wireless_get_channel(wifi),
+                                              nm_setting_wireless_get_band(wifi));
+    if (!frequency
+        || frequency != nm_platform_wifi_get_frequency(platform, nm_device_get_ifindex(parent))) {
+        g_set_error_literal(error,
+                            NM_DEVICE_ERROR,
+                            NM_DEVICE_ERROR_FAILED,
+                            "Wi-Fi Relay must use the current parent station channel");
+        return FALSE;
+    }
+    nm_random_get_bytes(priv->relay_mac, sizeof(priv->relay_mac));
+    priv->relay_mac[0] = (priv->relay_mac[0] & 0xfe) | 0x02;
+    r                  = nm_platform_wifi_relay_add(platform,
+                                                    nm_device_get_ifindex(parent),
+                                                    nm_device_get_iface(device),
+                                                    frequency,
+                                                    priv->relay_mac,
+                                                    out_link);
+    if (r < 0) {
+        g_set_error(
+            error,
+            NM_DEVICE_ERROR,
+            NM_DEVICE_ERROR_CREATION_FAILED,
+            "Cannot create concurrent Wi-Fi Relay AP (driver/interface capacity/channel): %s",
+            nm_strerror(r));
+        return FALSE;
+    }
+    priv->relay_ifindex   = (*out_link)->ifindex;
+    priv->relay_frequency = frequency;
+    g_set_object(&priv->relay_parent_connection, nm_device_get_applied_connection(parent));
+    priv->capabilities = NM_DEVICE_WIFI_GET_PRIVATE(parent)->capabilities;
+    _notify(NM_DEVICE_WIFI(device), PROP_CAPABILITIES);
+    nm_device_parent_set_ifindex(device, nm_device_get_ifindex(parent));
+    priv->relay_watch = g_timeout_add_seconds(1, relay_parent_watch, device);
+    return TRUE;
+}
+
+static NMDeviceCapabilities
+relay_get_generic_capabilities(NMDevice *device)
+{
+    return NM_DEVICE_WIFI_GET_PRIVATE(device)->relay_virtual ? NM_DEVICE_CAP_IS_SOFTWARE
+                                                             : NM_DEVICE_CAP_NONE;
+}
