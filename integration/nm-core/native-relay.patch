index a780a3e..29a5b0b 100644
--- a/src/core/devices/wifi/tests/test-devices-wifi.c
+++ b/src/core/devices/wifi/tests/test-devices-wifi.c
@@ -8,9 +8,13 @@
 #include "devices/wifi/nm-wifi-utils.h"
 #include "devices/wifi/nm-wifi-ap.h"
 #include "devices/wifi/nm-device-wifi.h"
+#include "devices/wifi/nm-wifi-relay-utils.h"
 #include "libnm-core-intern/nm-core-internal.h"
 
 #include "nm-test-utils-core.h"
+#include "libnm-core-intern/nm-wifi-relay.h"
+#include "libnm-platform/wifi/nm-wifi-utils-nl80211.h"
+#include <linux/nl80211.h>
 
 #define DEBUG 1
 
@@ -1560,6 +1564,243 @@ test_ap_check_compatible_band(void)
 
 NMTST_DEFINE();
 
+/* Downstream Wi-Fi Relay regression tests: LGPL-2.1-or-later. */
+static NMConnection *
+relay_test_connection(void)
+{
+    NMConnection          *connection = nm_simple_connection_new();
+    NMSetting             *con        = nm_setting_connection_new();
+    NMSetting             *wifi       = nm_setting_wireless_new();
+    NMSetting             *security   = nm_setting_wireless_security_new();
+    NMSetting             *ip4        = nm_setting_ip4_config_new();
+    NMSetting             *ip6        = nm_setting_ip6_config_new();
+    NMSettingUser         *user       = NM_SETTING_USER(nm_setting_user_new());
+    gs_unref_bytes GBytes *ssid       = g_bytes_new_static("Relay test", 10);
+
+    g_object_set(con,
+                 NM_SETTING_CONNECTION_ID,
+                 "Relay test",
+                 NM_SETTING_CONNECTION_UUID,
+                 "de56a052-a2d5-4ee4-b13d-6304eb15dc60",
+                 NM_SETTING_CONNECTION_TYPE,
+                 NM_SETTING_WIRELESS_SETTING_NAME,
+                 NM_SETTING_CONNECTION_INTERFACE_NAME,
+                 "nm-relay0",
+                 NM_SETTING_CONNECTION_AUTOCONNECT,
+                 FALSE,
+                 NULL);
+    g_object_set(wifi,
+                 NM_SETTING_WIRELESS_SSID,
+                 ssid,
+                 NM_SETTING_WIRELESS_MODE,
+                 "ap",
+                 NM_SETTING_WIRELESS_BAND,
+                 "bg",
+                 NM_SETTING_WIRELESS_CHANNEL,
+                 6u,
+                 NM_SETTING_WIRELESS_CLONED_MAC_ADDRESS,
+                 "preserve",
+                 NULL);
+    g_object_set(security,
+                 NM_SETTING_WIRELESS_SECURITY_KEY_MGMT,
+                 "wpa-psk",
+                 NM_SETTING_WIRELESS_SECURITY_PSK,
+                 "relay-test-password",
+                 NULL);
+    nm_setting_wireless_security_add_proto(NM_SETTING_WIRELESS_SECURITY(security), "rsn");
+    g_object_set(ip4, NM_SETTING_IP_CONFIG_METHOD, "shared", NULL);
+    g_object_set(ip6, NM_SETTING_IP_CONFIG_METHOD, "disabled", NULL);
+    nm_setting_user_set_data(user, NM_WIFI_RELAY_PARENT_KEY, "wlan0", NULL);
+    nm_connection_add_setting(connection, con);
+    nm_connection_add_setting(connection, wifi);
+    nm_connection_add_setting(connection, security);
+    nm_connection_add_setting(connection, ip4);
+    nm_connection_add_setting(connection, ip6);
+    nm_connection_add_setting(connection, NM_SETTING(user));
+    return connection;
+}
+
+static void
+test_relay_profile(void)
+{
+    gs_unref_object NMConnection *connection = relay_test_connection();
+    gs_unref_object NMConnection *roundtrip  = NULL;
+    gs_unref_variant GVariant    *settings   = NULL;
+    gs_free_error GError         *error      = NULL;
+
+    g_assert_true(nm_connection_is_virtual(connection));
+    g_assert_true(nm_connection_verify(connection, &error));
+    g_assert_no_error(error);
+    settings  = nm_connection_to_dbus(connection, NM_CONNECTION_SERIALIZE_ALL);
+    roundtrip = nm_simple_connection_new_from_dbus(settings, &error);
+    g_assert_no_error(error);
+    g_assert_cmpstr(nm_wifi_relay_get_parent(roundtrip), ==, "wlan0");
+    g_assert_true(nm_connection_is_virtual(roundtrip));
+    nm_setting_user_set_data(
+        NM_SETTING_USER(nm_connection_get_setting(connection, NM_TYPE_SETTING_USER)),
+        NM_WIFI_RELAY_PARENT_KEY,
+        NULL,
+        NULL);
+    g_assert_false(nm_connection_is_virtual(connection));
+    g_assert_true(nm_connection_verify(connection, &error));
+    g_assert_no_error(error);
+}
+
+static void
+test_relay_invalid_profile(void)
+{
+    int i;
+
+    for (i = 0; i < 9; i++) {
+        gs_unref_object NMConnection *connection = relay_test_connection();
+        gs_free_error GError         *error      = NULL;
+        NMSettingWireless            *wifi       = nm_connection_get_setting_wireless(connection);
+
+        switch (i) {
+        case 0:
+            nm_setting_user_set_data(
+                NM_SETTING_USER(nm_connection_get_setting(connection, NM_TYPE_SETTING_USER)),
+                NM_WIFI_RELAY_PARENT_KEY,
+                "nm-relay0",
+                NULL);
+            break;
+        case 1:
+            nm_setting_user_set_data(
+                NM_SETTING_USER(nm_connection_get_setting(connection, NM_TYPE_SETTING_USER)),
+                NM_WIFI_RELAY_PARENT_KEY,
+                "bad/name",
+                NULL);
+            break;
+        case 2:
+            g_object_set(wifi, NM_SETTING_WIRELESS_MODE, "infrastructure", NULL);
+            break;
+        case 3:
+            g_object_set(wifi, NM_SETTING_WIRELESS_CHANNEL, 0u, NULL);
+            break;
+        case 4:
+            g_object_set(nm_connection_get_setting_ip4_config(connection),
+                         NM_SETTING_IP_CONFIG_METHOD,
+                         "auto",
+                         NULL);
+            break;
+        case 5:
+            g_object_set(nm_connection_get_setting_connection(connection),
+                         NM_SETTING_CONNECTION_AUTOCONNECT,
+                         TRUE,
+                         NULL);
+            break;
+        case 6:
+            g_object_set(wifi, NM_SETTING_WIRELESS_CLONED_MAC_ADDRESS, "random", NULL);
+            break;
+        case 7:
+            nm_setting_wireless_security_add_proto(
+                nm_connection_get_setting_wireless_security(connection),
+                "wpa");
+            break;
+        case 8:
+            g_object_set(nm_connection_get_setting_connection(connection),
+                         NM_SETTING_CONNECTION_INTERFACE_NAME,
+                         NULL,
+                         NULL);
+            break;
+        }
+        g_assert_false(nm_connection_verify(connection, &error));
+        g_assert_error(error, NM_CONNECTION_ERROR, NM_CONNECTION_ERROR_INVALID_PROPERTY);
+    }
+}
+
+static void
+test_relay_owned_link(void)
+{
+    const guint8   mac[6] = {2, 1, 2, 3, 4, 5};
+    NMPlatformLink link   = {.ifindex = 21, .type = NM_LINK_TYPE_WIFI, .l_address.len = 6};
+
+    g_strlcpy(link.name, "nm-relay0", sizeof(link.name));
+    memcpy(link.l_address.data, mac, 6);
+    g_assert_true(nm_wifi_relay_link_owned(&link, 21, "nm-relay0", mac));
+    g_assert_false(nm_wifi_relay_link_owned(NULL, 21, "nm-relay0", mac));
+    g_assert_false(nm_wifi_relay_link_owned(&link, 22, "nm-relay0", mac));
+    g_assert_false(nm_wifi_relay_link_owned(&link, 21, "wlan0", mac));
+    link.l_address.data[5]++;
+    g_assert_false(nm_wifi_relay_link_owned(&link, 21, "nm-relay0", mac));
+    memcpy(link.l_address.data, mac, 6);
+    link.l_address.len = 0;
+    g_assert_false(nm_wifi_relay_link_owned(&link, 21, "nm-relay0", mac));
+    link.l_address.len = 6;
+    link.type          = NM_LINK_TYPE_DUMMY;
+    g_assert_false(nm_wifi_relay_link_owned(&link, 21, "nm-relay0", mac));
+}
+
+static void
+test_relay_delete_message(void)
+{
+    nm_auto_nlmsg struct nl_msg *msg  = nm_wifi_utils_nl80211_relay_delete_message(42, 25);
+    struct nlmsghdr             *hdr  = nlmsg_hdr(msg);
+    struct genlmsghdr           *genl = genlmsg_hdr(hdr);
+    struct nlattr               *tb[NL80211_ATTR_MAX + 1];
+    g_assert_cmpint(hdr->nlmsg_type, ==, 42);
+    g_assert_cmpint(genl->cmd, ==, NL80211_CMD_DEL_INTERFACE);
+    g_assert_cmpint(nla_parse_arr(tb, genlmsg_attrdata(genl, 0), genlmsg_attrlen(genl, 0), NULL),
+                    ==,
+                    0);
+    g_assert_nonnull(tb[NL80211_ATTR_IFINDEX]);
+    g_assert_cmpint(nla_get_u32(tb[NL80211_ATTR_IFINDEX]), ==, 25);
+    g_assert_null(tb[NL80211_ATTR_WIPHY]);
+    g_assert_null(tb[NL80211_ATTR_IFNAME]);
+}
+
+static int
+relay_test_put_u32(struct nl_msg *msg, int type, guint32 value)
+{
+    return nla_put(msg, type, sizeof(value), &value);
+}
+
+static void
+test_relay_combinations(void)
+{
+    int i;
+
+    for (i = 0; i < 8; i++) {
+        nm_auto_nlmsg struct nl_msg *msg         = nlmsg_alloc(0);
+        struct nlattr               *combination = nla_nest_start(msg, 1);
+        struct nlattr               *limits, *limit, *types;
+        int                          count;
+
+        g_assert_cmpint(
+            relay_test_put_u32(msg, NL80211_IFACE_COMB_MAXNUM, i == 2 ? 1 : (i == 6 ? 3 : 2)),
+            ==,
+            0);
+        g_assert_cmpint(relay_test_put_u32(msg, NL80211_IFACE_COMB_NUM_CHANNELS, i == 3 ? 0 : 1),
+                        ==,
+                        0);
+        limits = nla_nest_start(msg, NL80211_IFACE_COMB_LIMITS);
+        for (count = 0; count < (i >= 6 ? 3 : (i == 0 || i == 2 || i == 3 || i == 5 ? 2 : 1));
+             count++) {
+            limit = nla_nest_start(msg, count + 1);
+            g_assert_cmpint(relay_test_put_u32(msg, NL80211_IFACE_LIMIT_MAX, i == 4 ? 2 : 1),
+                            ==,
+                            0);
+            types = nla_nest_start(msg, NL80211_IFACE_LIMIT_TYPES);
+            if (count == 0)
+                g_assert_cmpint(nla_put(msg, NL80211_IFTYPE_STATION, 0, NULL), ==, 0);
+            if (count == 1 || i == 1 || i == 4) {
+                if (i != 5)
+                    g_assert_cmpint(nla_put(msg, NL80211_IFTYPE_AP, 0, NULL), ==, 0);
+            }
+            if (count == 2)
+                g_assert_cmpint(nla_put(msg, NL80211_IFTYPE_P2P_DEVICE, 0, NULL), ==, 0);
+            nla_nest_end(msg, types);
+            nla_nest_end(msg, limit);
+        }
+        nla_nest_end(msg, limits);
+        nla_nest_end(msg, combination);
+        g_assert_cmpint(
+            nm_wifi_utils_nl80211_relay_combination_supported(combination, i >= 6 ? 1 : 0),
+            ==,
+            i == 0 || i == 4 || i == 6);
+    }
+}
+
 int
 main(int argc, char **argv)
 {
@@ -1708,5 +1949,11 @@ main(int argc, char **argv)
 
     g_test_add_func("/wifi/ap/check_compatible_band", test_ap_check_compatible_band);
 
+    g_test_add_func("/wifi/relay/delete-message", test_relay_delete_message);
+    g_test_add_func("/wifi/relay/owned-interface", test_relay_owned_link);
+    g_test_add_func("/wifi/relay/profile", test_relay_profile);
+    g_test_add_func("/wifi/relay/invalid-profile", test_relay_invalid_profile);
+    g_test_add_func("/wifi/relay/interface-combinations", test_relay_combinations);
+
     return g_test_run();
 }
