+gboolean
+nm_wifi_utils_nl80211_relay_combination_supported(const struct nlattr *combination,
+                                                  guint                p2p_devices)
+{
+    struct nlattr *tb[NUM_NL80211_IFACE_COMB];
+    struct nlattr *limit;
+    int            rem;
+    gboolean       station = FALSE, ap = FALSE, p2p = FALSE;
+
+    if (nla_parse_nested_arr(tb, combination, NULL) < 0 || !tb[NL80211_IFACE_COMB_MAXNUM]
+        || nla_len(tb[NL80211_IFACE_COMB_MAXNUM]) != 4
+        || nla_get_u32(tb[NL80211_IFACE_COMB_MAXNUM]) < 2 + p2p_devices
+        || !tb[NL80211_IFACE_COMB_NUM_CHANNELS] || nla_len(tb[NL80211_IFACE_COMB_NUM_CHANNELS]) != 4
+        || nla_get_u32(tb[NL80211_IFACE_COMB_NUM_CHANNELS]) < 1 || !tb[NL80211_IFACE_COMB_LIMITS])
+        return FALSE;
+    nla_for_each_nested (limit, tb[NL80211_IFACE_COMB_LIMITS], rem) {
+        struct nlattr *lt[NUM_NL80211_IFACE_LIMIT];
+        struct nlattr *type;
+        int            rem_type;
+        guint          required = 0;
+
+        if (nla_parse_nested_arr(lt, limit, NULL) < 0 || !lt[NL80211_IFACE_LIMIT_MAX]
+            || nla_len(lt[NL80211_IFACE_LIMIT_MAX]) != 4 || !lt[NL80211_IFACE_LIMIT_TYPES])
+            return FALSE;
+        nla_for_each_nested (type, lt[NL80211_IFACE_LIMIT_TYPES], rem_type) {
+            if (nla_type(type) == NL80211_IFTYPE_STATION) {
+                station = TRUE;
+                required++;
+            } else if (nla_type(type) == NL80211_IFTYPE_AP) {
+                ap = TRUE;
+                required++;
+            } else if (nla_type(type) == NL80211_IFTYPE_P2P_DEVICE) {
+                p2p = TRUE;
+                required += p2p_devices;
+            }
+        }
+        if (required > nla_get_u32(lt[NL80211_IFACE_LIMIT_MAX]))
+            return FALSE;
+    }
+    return station && ap && (!p2p_devices || p2p);
+}
