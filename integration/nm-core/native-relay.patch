 static _NM80211Mode
 wifi_get_mode(NMPlatform *platform, int ifindex)
 {
@@ -12514,6 +12552,8 @@ nm_linux_platform_class_init(NMLinuxPlatformClass *klass)
     platform_class->wifi_get_capabilities            = wifi_get_capabilities;
     platform_class->wifi_get_frequency               = wifi_get_frequency;
     platform_class->wifi_get_station                 = wifi_get_station;
+    platform_class->wifi_relay_delete                = wifi_relay_delete;
+    platform_class->wifi_relay_add                   = wifi_relay_add;
     platform_class->wifi_get_mode                    = wifi_get_mode;
