+typedef struct {
+    int      phy, parent, count;
+    guint    p2p_devices;
+    gboolean parent_found;
+} RelayInterfaces;
+
+static int
+relay_interfaces_handler(const struct nl_msg *msg, void *arg)
+{
+    RelayInterfaces   *interfaces = arg;
+    struct genlmsghdr *header     = nlmsg_data(nlmsg_hdr(msg));
+    struct nlattr     *tb[NL80211_ATTR_MAX + 1];
+
+    if (nla_parse_arr(tb, genlmsg_attrdata(header, 0), genlmsg_attrlen(header, 0), NULL) < 0)
+        return NL_SKIP;
+    if (tb[NL80211_ATTR_WIPHY] && nla_get_u32(tb[NL80211_ATTR_WIPHY]) == interfaces->phy) {
+        if (tb[NL80211_ATTR_IFINDEX]) {
+            interfaces->count++;
+            if (nla_get_u32(tb[NL80211_ATTR_IFINDEX]) == interfaces->parent)
+                interfaces->parent_found = TRUE;
+        } else if (tb[NL80211_ATTR_IFTYPE]
+                   && nla_get_u32(tb[NL80211_ATTR_IFTYPE]) == NL80211_IFTYPE_P2P_DEVICE)
+            interfaces->p2p_devices++;
+        else
+            interfaces->count++;
+    }
+    return NL_SKIP;
+}
+
+static int
+relay_created_handler(const struct nl_msg *msg, void *arg)
+{
+    struct genlmsghdr *header = nlmsg_data(nlmsg_hdr(msg));
+    struct nlattr     *tb[NL80211_ATTR_MAX + 1];
+
+    if (nla_parse_arr(tb, genlmsg_attrdata(header, 0), genlmsg_attrlen(header, 0), NULL) >= 0
+        && tb[NL80211_ATTR_IFINDEX] && nla_len(tb[NL80211_ATTR_IFINDEX]) == 4)
+        *((int *) arg) = nla_get_u32(tb[NL80211_ATTR_IFINDEX]);
+    return NL_SKIP;
+}
+
+struct nl_msg *
+nm_wifi_utils_nl80211_relay_delete_message(guint16 family_id, int ifindex)
+{
+    g_return_val_if_fail(ifindex > 0, NULL);
+    return _nl80211_alloc_msg(family_id, ifindex, -1, NL80211_CMD_DEL_INTERFACE, 0);
+}
+
+static int
+wifi_nl80211_relay_delete(NMWifiUtils *data)
+{
+    NMWifiUtilsNl80211          *self = (NMWifiUtilsNl80211 *) data;
+    nm_auto_nlmsg struct nl_msg *msg =
+        nm_wifi_utils_nl80211_relay_delete_message(self->genl_family_id, data->ifindex);
+    if (!msg)
+        return -ENOMEM;
+    return nl80211_send_and_recv(self, msg, NULL, NULL);
+}
+
+static int
+wifi_nl80211_relay_add(NMWifiUtils *data, const char *name, guint32 frequency, const guint8 *mac)
+{
+    NMWifiUtilsNl80211          *self       = (NMWifiUtilsNl80211 *) data;
+    struct nl80211_device_info   info       = {.self = self};
+    RelayInterfaces              interfaces = {.phy = self->phy, .parent = data->ifindex};
+    nm_auto_nlmsg struct nl_msg *msg        = NULL;
+    gboolean                     permitted  = FALSE;
+    int                          r, i, created_ifindex = 0;
+
+    if (wifi_nl80211_get_mode(data) != _NM_802_11_MODE_INFRA
+        || wifi_nl80211_get_freq(data) != frequency)
+        return -ENOTCONN;
+    nm_clear_pointer(&msg, nlmsg_free);
+    msg = nlmsg_alloc(0);
+    genlmsg_put(msg,
+                NL_AUTO_PORT,
+                NL_AUTO_SEQ,
+                self->genl_family_id,
+                0,
+                NLM_F_DUMP,
+                NL80211_CMD_GET_INTERFACE,
+                0);
+    r = nl80211_send_and_recv(self, msg, relay_interfaces_handler, &interfaces);
+    if (r < 0)
+        return r;
+    if (!interfaces.parent_found || interfaces.count != 1)
+        return -EBUSY;
+    nm_clear_pointer(&msg, nlmsg_free);
+    info.relay_p2p_devices = interfaces.p2p_devices;
+    msg                    = nl80211_alloc_msg(self, NL80211_CMD_GET_WIPHY, 0);
+    r                      = nl80211_send_and_recv(self, msg, nl80211_wiphy_info_handler, &info);
+    if (r >= 0 && info.relay_supported) {
+        for (i = 0; i < info.num_freqs; i++) {
+            if (info.freqs[i].freq == frequency && !info.freqs[i].disabled && !info.freqs[i].no_ir
+                && !info.freqs[i].radar)
+                permitted = TRUE;
+        }
+    }
+    g_free(info.freqs);
+    if (r < 0)
+        return r;
+    if (!permitted)
+        return -EOPNOTSUPP;
+    /* Recheck the station after the preflight queries, before creating resources. */
+    if (wifi_nl80211_get_freq(data) != frequency)
+        return -ENOTCONN;
+    nm_clear_pointer(&msg, nlmsg_free);
+    msg = nl80211_alloc_msg(self, NL80211_CMD_NEW_INTERFACE, 0);
+    NLA_PUT_STRING(msg, NL80211_ATTR_IFNAME, name);
+    NLA_PUT_U32(msg, NL80211_ATTR_IFTYPE, NL80211_IFTYPE_AP);
+    NLA_PUT(msg, NL80211_ATTR_MAC, 6, mac);
+    r = nl80211_send_and_recv(self, msg, relay_created_handler, &created_ifindex);
+    return r < 0 ? r : (created_ifindex > 0 ? created_ifindex : -ENODEV);
+
+nla_put_failure:
+    return -ENOMEM;
+}
